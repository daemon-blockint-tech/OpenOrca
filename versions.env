# Pinned versions — OpenOrca dev stack.
# Usage: docker compose --env-file versions.env up -d
# Image refs pin TAG@DIGEST: tag utk keterbacaan, digest utk reproducibility (tag bisa
# bergerak di upstream; digest = persis image yang lolos hardening CIS + healthcheck live).
TYPEDB_VERSION=3.12.3
POSTGRES_VERSION=18.4-alpine
TYPEDB_IMAGE=typedb/typedb:3.12.3@sha256:7555df2fffd5354553143facbfc81a58ce7036e4cc8b3b50bc7139faff4a721f
POSTGRES_IMAGE=postgres:18.4-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
# Host-side ports — NOT the defaults (1729/8000/5432). Moved off common local-dev-tool
# defaults after real collisions on a dev machine (SPEC.md §B B2, B3); container-internal
# ports stay at each image's own default. Single source of truth for compose + dev-up.sh.
TYPEDB_HTTP_PORT=8729
POSTGRES_PORT=5433
# Cluster components — installed by scripts/dev-up.sh (factory/specs/active/OO-001-dev-infra.md).
KIND_CLUSTER_NAME=openorca
ARGOCD_VERSION=v3.5.1
ARGO_ROLLOUTS_VERSION=v1.9.1
